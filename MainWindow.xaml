<Window x:Class="MP3Pro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MP3Pro"
        Title="MP3Pro - Modern Editor" Height="700" Width="1150"
        Background="#F5F5F7" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ValueToHeightConverter x:Key="ValueToHeightConverter"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E5EA"/>
            <Setter Property="Foreground" Value="#1C1C1E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D1D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Border Background="White" CornerRadius="16" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="20" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#E5F1FF" CornerRadius="8" Margin="0,0,15,0">
                            <TextBlock Text="🎵" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MP3PRO EDITOR" Foreground="#1C1C1E" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="Hassas Ses Düzenleme Aracı" Foreground="#8E8E93" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Dosya Seç" Style="{StaticResource PrimaryButton}" Command="{Binding OpenFileCommand}" HorizontalAlignment="Right"/>
                </DockPanel>

                <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="12" Margin="0,15,0,30" BorderThickness="1" BorderBrush="#E5E5EA"
                        MouseLeftButtonDown="Waveform_MouseDown" 
                        MouseMove="Waveform_MouseMove" 
                        MouseLeftButtonUp="Waveform_MouseUp" 
                        Cursor="Cross">
                    <Grid>
                        
                        <ItemsControl ItemsSource="{Binding WaveformPeaks}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="2" Margin="0.5" RadiusX="1" RadiusY="1">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#007AFF" Offset="0"/>
                                                <GradientStop Color="#80BFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource ValueToHeightConverter}">
                                                <Binding />
                                                <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Canvas IsHitTestVisible="False">
                            <Rectangle Fill="#20007AFF" Canvas.Left="{Binding SelectionStartPos}" 
                                       Width="{Binding SelectionWidth}" 
                                       Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                       Stroke="#007AFF" StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,30">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SEÇİLİ BÖLGE" Foreground="#8E8E93" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StartTimeDisplay}" FontSize="60" FontFamily="Consolas" Foreground="#1C1C1E" FontWeight="Light"/>
                            <TextBlock Text="-" FontSize="60" Foreground="#D1D1D6" Margin="20,-5,20,0" VerticalAlignment="Center" FontWeight="Light"/>
                            <TextBlock Text="{Binding EndTimeDisplay}" FontSize="60" FontFamily="Consolas" Foreground="#007AFF" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="▶ Oynat" Command="{Binding PlayCommand}" Style="{StaticResource SecondaryButton}" Width="120" Margin="0,0,15,0"/>
                        <Button Content="⏹ Durdur" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Width="120"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,25,0" Foreground="#8E8E93" FontSize="13"/>
                        <Button Content="Kes ve Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Width="160"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>